# Currency Symbol
NEXT_PUBLIC_CURRENCY_SYMBOL = '$'

# PostHog client tracking
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# PostHog admin analytics queries (server-only)
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_APP_HOST=https://us.posthog.com

# Meta Pixel + Conversions API
NEXT_PUBLIC_META_PIXEL_ID=
# Server-only Meta event source id used in the Graph /{id}/events endpoint.
# Use the Pixel ID for web Pixel+CAPI dedup unless Meta instructs this dataset to use a separate event source ID.
META_CAPI_EVENT_SOURCE_ID=
META_CAPI_ACCESS_TOKEN=
# Optional server-only code from Meta Events Manager > Test Events
META_TEST_EVENT_CODE=
