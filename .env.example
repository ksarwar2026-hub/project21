# K-SARWAR environment template
# Copy to .env.local for local development and fill with development/test values only.
# Never commit real secrets.

# Environment label used by safe local tooling.
DB_ENVIRONMENT=development
NEXT_PUBLIC_APP_ENV=development

# Site URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
SITE_URL=http://localhost:3000

# Currency Symbol
NEXT_PUBLIC_CURRENCY_SYMBOL=Rs

# Admin access
ADMIN_EMAIL=
NEXT_PUBLIC_ADMIN_PATH=
NEXT_PUBLIC_STORE_PATH=

# Database - use a development Neon project/branch locally.
# DATABASE_URL should normally be the pooled Neon URL.
# DIRECT_URL should normally be the direct Neon URL for Prisma migrations.
DATABASE_URL=
DIRECT_URL=

# Clerk - use a development/test Clerk application locally.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Inngest
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ImageKit
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# Razorpay - use test mode keys locally.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# PostHog client tracking
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# PostHog admin analytics queries - server-only
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_APP_HOST=https://us.posthog.com

# Meta Pixel + Conversions API
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_EVENT_SOURCE_ID=
META_CAPI_ACCESS_TOKEN=
META_TEST_EVENT_CODE=

# Legacy/fallback auth secret if ever used by code or future integrations.
NEXTAUTH_SECRET=

# WhatsApp
# Current app only has a public wa.me link and a no-op order confirmation hook.
# Add real WhatsApp Cloud API env vars only when implementing that integration.
WHATSAPP_PHONE_NUMBER=
WHATSAPP_CLOUD_API_VERSION=
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_TEMPLATE_NAME=
WHATSAPP_DEV_TEST_RECIPIENT=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_APP_SECRET=
